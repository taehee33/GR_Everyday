<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Camera HTTP API over its Wi-Fi -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- USBCamera serves the same HTTP API on 127.0.0.1 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<!-- PTP over USB through ImageCaptureCore -->
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- macOS shows Wi-Fi names only with Location permission -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Default save folder ~/Pictures/GR -->
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
	<!-- A save folder the user picks, kept with a bookmark; 다른 이름으로 저장; camera pictures -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Sign in with Apple for 순간 (Moments); Supabase verifies the identity token -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
