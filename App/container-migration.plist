<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On the first sandboxed launch macOS moves these into the app's container, so shot
	     history, edits, ratings, camera pictures and caches from earlier builds carry over. -->
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/GR Mac</string>
		<string>${Library}/Caches/GR Mac</string>
		<string>${Library}/Logs/GRLink.log</string>
		<!-- Settings and registered cameras, staged here when the app's ID changed. -->
		<string>${Library}/Preferences/com.hantaehee.greveryday.plist</string>
		<!-- Data of the com.hantaehee.grconnect builds ("GR Mac"), if macOS lets it move
		     out of that container. Untested. -->
		<string>${Library}/Containers/com.hantaehee.grconnect/Data/Library/Application Support/GR Mac</string>
		<string>${Library}/Containers/com.hantaehee.grconnect/Data/Library/Caches/GR Mac</string>
	</array>
</dict>
</plist>
